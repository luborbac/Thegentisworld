<%- include('partials/head', {
  pageTitle: post.titulo,
  pageDescription: post.subtitulo || c.excerpt(post.corpo_html, 160),
  noindex: preview,
  og: url ? { title: post.titulo, description: post.subtitulo || c.excerpt(post.corpo_html, 160), url: url, image: post.capa ? url.replace(/\/texto\/.*$/, '') + post.capa : '' } : null
}) %>
<% if (preview) { %>
  <div class="faixa-previa">Pré-visualização · <%= post.status === 'publicado' ? 'publicado' : 'rascunho, não visível ao público' %> · <a href="<%= adminPath %>/editar/<%= post.id %>">voltar à edição</a></div>
<% } %>
<%- include('partials/header') %>
<article class="artigo">
  <header class="artigo-cabeca">
    <a class="selo" href="<%= post.editoria ? '/editoria/' + c.slugify(post.editoria) : '/textos' %>"><%= c.TIPOS[post.tipo] ? c.TIPOS[post.tipo].nome : 'Texto' %><% if (post.editoria) { %> · <%= post.editoria %><% } %></a>
    <h1 class="artigo-titulo"><%= post.titulo %></h1>
    <% if (post.subtitulo) { %><p class="linha-fina"><%= post.subtitulo %></p><% } %>
    <div class="artigo-meta">
      <a class="assinatura" href="/sobre">
        <% if (site.autora_foto) { %><img src="<%= site.autora_foto %>" alt="" width="68" height="68"><% } else { %><span class="avatar-letra grande" aria-hidden="true"><%= site.autora_nome.charAt(0) %></span><% } %>
        <span>
          <span class="assinatura-nome"><%= site.autora_nome %></span>
          <span class="assinatura-data"><%= post.publicado_em ? c.formatDate(post.publicado_em) : 'Sem data' %> · <%= c.readingMinutes(post.corpo_html) %> min de leitura</span>
        </span>
      </a>
      <% if (!preview) { %>
      <div class="compartilhe">
        <span class="compartilhe-rotulo">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M14 5l7 6-7 6v-4c-5 0-8 1.5-11 5 1-5 4-10 11-10V5z" fill="currentColor"/></svg>
          Compartilhe
        </span>
        <a class="rede" href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(post.titulo + ' ' + url) %>" target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
        </a>
        <a class="rede" href="https://t.me/share/url?url=<%= encodeURIComponent(url) %>&text=<%= encodeURIComponent(post.titulo) %>" target="_blank" rel="noopener" aria-label="Compartilhar no Telegram">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.5 4.3 18.4 19c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.3.3-.5.5-1 .5l.3-4.7 8.6-7.8c.4-.3-.1-.5-.6-.2L6.6 13 2 11.6c-1-.3-1-1 .2-1.5L20.2 3.2c.8-.3 1.6.2 1.3 1.1z"/></svg>
        </a>
        <a class="rede" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(url) %>" target="_blank" rel="noopener" aria-label="Compartilhar no Facebook">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-7.5H16l.4-3h-2.9V8.6c0-.9.3-1.5 1.5-1.5h1.5V4.4a20 20 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.4V21h3.1z"/></svg>
        </a>
        <a class="rede" href="https://x.com/intent/post?text=<%= encodeURIComponent(post.titulo) %>&url=<%= encodeURIComponent(url) %>" target="_blank" rel="noopener" aria-label="Compartilhar no X">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.5l11.2 14.5z"/></svg>
        </a>
        <button class="rede" type="button" data-copiar="<%= url %>" aria-label="Copiar link">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
        </button>
      </div>
      <% } %>
    </div>
  </header>

  <% if (post.capa) { %>
    <figure class="artigo-capa">
      <img src="<%= post.capa %>" alt="<%= post.capa_legenda || '' %>">
      <% if (post.capa_credito) { %><span class="credito">(<%= post.capa_credito %>)</span><% } %>
      <% if (post.capa_legenda) { %><figcaption><%= post.capa_legenda %></figcaption><% } %>
    </figure>
  <% } %>

  <div class="artigo-corpo">
    <%- post.corpo_html %>
  </div>

  <footer class="artigo-fim">
    <div class="autora-box compacta">
      <% if (site.autora_foto) { %><img src="<%= site.autora_foto %>" alt="" width="64" height="64"><% } else { %><span class="avatar-letra grande" aria-hidden="true"><%= site.autora_nome.charAt(0) %></span><% } %>
      <div>
        <p class="autora-nome"><%= site.autora_nome %></p>
        <p><%= site.autora_bio %></p>
      </div>
    </div>
    <p class="aviso-opiniao">Este é um texto de opinião. As análises e conclusões são de responsabilidade da autora.</p>
  </footer>
</article>

<% if (relacionados.length) { %>
<section class="pagina relacionados">
  <h2 class="secao-titulo">Leia também</h2>
  <div class="grade">
    <% relacionados.forEach(function (p) { %><%- include('partials/card', { p: p, comResumo: false }) %><% }) %>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
